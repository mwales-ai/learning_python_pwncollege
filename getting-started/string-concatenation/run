def secret_encoder(pt):
    ret_val = ""
    for i,c in enumerate(pt):
        cur_char_val = ord(c) - 0x20
        cur_char_val += 2 * i
        cur_char_val = cur_char_val % 0x5f
        ret_val += chr(cur_char_val + 0x20)
    return ret_val

def secret_decoder(ct):
    ret_val = ""
    for i,c in enumerate(ct):
        cur_char_val = ord(c) - 0x20 + (0x5f * len(ct))
        cur_char_val -= 2 * i
        cur_char_val = cur_char_val % 0x5f
        ret_val += chr(cur_char_val + 0x20)
    return ret_val




ct = secret_encoder(flag)
middle_index = len(ct) // 2

ct1 = ct[:middle_index]
ct2 = ct[middle_index:]

ct = None
flag = None
        

