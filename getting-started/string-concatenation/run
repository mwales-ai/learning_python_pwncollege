#!/usr/bin/exec-suid -- /usr/local/bin/python3 -I -i

import sys

flag  = "Well done coder!  " + open("/flag","r").read().strip()
#flag = "wildcat{super_long_piece_of_text_without_newlines_what_the_heck_when_will_this_end}"

# Print a fake header like it was the real python
print("Python 3.12.11 (main, Jun  3 2025, 15:41:47) [GCC 14.2.1 20250322] on linux")
